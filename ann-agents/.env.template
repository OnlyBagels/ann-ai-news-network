# ANN Agents - Environment Configuration

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API Keys (at least one required)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External API Keys (optional, for ingestion)
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional. WebSearchResearcher uses Tavily when set, falls back to
# DuckDuckGo HTML scrape (free, no key) when unset.
TAVILY_API_KEY=

# Database
# format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=<schema>
DATABASE_URL=

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Agent Configuration
MAX_CONCURRENT_STORIES=10
AGENT_TIMEOUT_SECONDS=120
ANN_SCHEDULER_ENABLED=true
ANN_SCHEDULER_INTERVAL_MINUTES=15
ANN_SCHEDULER_STARTUP_DELAY_SECONDS=5
ANN_ALL_NEWS_LIMIT_PER_FEED=8
ANN_INCLUDE_AI_SPECIALIST_SOURCES=false
ANN_REPORTER_EXECUTION_MODE=all
ANN_REPORTER_PARALLEL_LIMIT=24

# Secondary reviewer (DigitalOcean Inference, OpenAI-compatible)
ANN_DO_REVIEWER_ENABLED=false
ANN_DO_REVIEWER_BASE_URL=https://inference.do-ai.run/v1
ANN_DO_REVIEWER_API_KEY=
ANN_DO_REVIEWER_MODEL=llama3.3-70b-instruct
ANN_DO_REVIEWER_TIMEOUT_SECONDS=20

# Optional auto-approve gate for exceptionally high-confidence drafts.
# Keep false if you want everything to pass through /admin/review.
ANN_AUTO_APPROVE_ENABLED=false
ANN_AUTO_APPROVE_MIN_CONFIDENCE=0.95
ANN_AUTO_APPROVE_MAX_HALLUCINATION_RISK=0.06
ANN_AUTO_APPROVE_MIN_VERIFIED_CLAIMS=3
ANN_AUTO_APPROVE_MIN_CITATIONS=2
ANN_AUTO_APPROVE_MIN_BODY_CHARS=900

# Publisher (where the agents post finished drafts for human review)
ANN_WEB_URL=http://localhost:3000
ANN_AGENT_SECRET=
