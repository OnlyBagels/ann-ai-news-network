# ANN Agents - Environment Configuration

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API Keys (at least one required)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External API Keys (optional, for ingestion)
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Database
# format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=<schema>
DATABASE_URL=

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Agent API: when set, every call needs "Authorization: Bearer <token>".
# Set the same value as AGENT_API_TOKEN in ann-web/.env.local.
AGENT_API_TOKEN=

# Agent Configuration
MAX_CONCURRENT_STORIES=10
AGENT_TIMEOUT_SECONDS=120

# Live broadcast (python -m ann_agents.broadcast)
# Claude writes the anchors' lines and a second Claude call checks them.
# Without ANTHROPIC_API_KEY the channel airs straight headline reads.
BROADCAST_WRITER_MODEL=claude-haiku-4-5
BROADCAST_FEATURE_MODEL=claude-sonnet-5-5
BROADCAST_STANDARDS_MODEL=claude-sonnet-5-5
BROADCAST_LLM_STANDARDS=true
BROADCAST_DAILY_BUDGET_USD=5
# Write only while someone checked in within this window (web viewers or the streamer)
BROADCAST_VIEWER_WINDOW_SECONDS=180
# How far ahead of air to keep the timeline written
BROADCAST_LOOKAHEAD_SECONDS=150
BROADCAST_STORY_COOLDOWN_HOURS=6
# Voices: none (captions only) or piper (local, free; see README)
BROADCAST_TTS=none
BROADCAST_PIPER_BIN=piper
BROADCAST_PIPER_VOICES_DIR=../voices
# Must match BROADCAST_AUDIO_DIR in ann-web/.env.local
BROADCAST_AUDIO_DIR=../broadcast-audio

# Self-hosted models (Ollama, llama.cpp, LM Studio, vLLM), comma separated
LOCAL_LLM_BASE_URLS=
LOCAL_LLM_MODEL=gemma4:e4b
LOCAL_LLM_REASONING_EFFORT=none
NEWSROOM_LEAN=true

# WaterSheep: python -m ann_agents.llm.watersheep --download
WATERSHEEP_DIR=../models/watersheep
