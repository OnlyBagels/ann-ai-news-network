# ANN Agents - Environment Configuration

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API Keys (at least one required)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External API Keys (optional, for ingestion)
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional. WebSearchResearcher uses Tavily when set, falls back to
# DuckDuckGo HTML scrape (free, no key) when unset.
TAVILY_API_KEY=

# Database
# format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=<schema>
DATABASE_URL=

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Agent Configuration
MAX_CONCURRENT_STORIES=10
AGENT_TIMEOUT_SECONDS=120
ANN_SCHEDULER_ENABLED=true
ANN_SCHEDULER_INTERVAL_MINUTES=15
ANN_SCHEDULER_STARTUP_DELAY_SECONDS=5

# Publisher (where the agents post finished drafts for human review)
ANN_WEB_URL=http://localhost:3000
ANN_AGENT_SECRET=
