# Copy to .env for docker compose. Every service reads this file.

# ─── Required ───
POSTGRES_PASSWORD=change-me
MEILI_MASTER_KEY=change-me-to-a-long-random-string

# ─── Who writes ───
# Self-hosted models: one or more OpenAI-compatible servers, comma separated.
# With the local-models profile on this box: http://ollama:11434/v1
# On other machines: http://10.0.0.11:11434/v1,http://10.0.0.12:11434/v1
LOCAL_LLM_BASE_URLS=
LOCAL_LLM_MODEL=qwen2.5:7b
# Optional bigger model for fact-checking and the standards desk
LOCAL_LLM_PREMIUM_MODEL=
# Or Claude. With both set, the newsroom uses local models first and the
# live channel uses Claude (set BROADCAST_LLM=local to keep it local too).
ANTHROPIC_API_KEY=

# ─── Live channel ───
# auto | claude | local | none
BROADCAST_LLM=auto
# Standards desk: same | claude | local. "claude" with local writing pays
# only for the short review and catches more than a small local model.
BROADCAST_DESK_LLM=same
BROADCAST_TTS=piper
# One writer per model server
BROADCAST_WRITERS=1
# CPU models: keep this many seconds written ahead, and air a headline read
# when less than BROADCAST_MIN_RUNWAY_SECONDS is queued
BROADCAST_LOOKAHEAD_SECONDS=600
BROADCAST_MIN_RUNWAY_SECONDS=90
BROADCAST_WRITE_TIMEOUT_SECONDS=300
BROADCAST_DAILY_BUDGET_USD=5

# ─── Newsroom ───
# About 5 model calls per story instead of 14. Turn on for CPU models.
NEWSROOM_LEAN=true
NEWSROOM_INTERVAL_MINUTES=15
MAX_CONCURRENT_STORIES=10

# ─── YouTube ───
# Stream key from YouTube Studio > Go live > Stream (streamer profile)
YOUTUBE_STREAM_KEY=
# Embed the stream on the site: channel id (UC...) or one live video id
YOUTUBE_CHANNEL_ID=
YOUTUBE_VIDEO_ID=
YOUTUBE_DELAY_SECONDS=20

# ─── Site ───
WEB_PORT=3000
# Editors sign in at /admin/login with this. Admin pages stay locked while
# it is empty. Make it long and random: openssl rand -base64 32
ADMIN_TOKEN=
# The session cookie is Secure in production. Only for testing over plain
# http on a non-localhost address, set this to true.
ADMIN_COOKIE_INSECURE=
# Shared by the site and the agent API; the API refuses calls without it.
AGENT_API_TOKEN=
