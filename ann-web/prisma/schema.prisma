generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The AI beats (models .. regulation) form the AI section; the rest are
// the general news sections.
enum Category {
  models
  open_source
  coding_ai
  agents
  research
  security
  funding
  regulation
  world
  us
  politics
  business
  crypto
  tech
  science
  climate
  health
  sports
  entertainment
  gaming
  internet
}

enum StoryStatus {
  raw
  clustered
  investigating
  enriched
  verified
  edited
  reviewed
  approved
  published
  rejected
  needs_human_review
}

model Article {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  url             String     @unique
  source          String
  sourceUrl       String?
  author          String?
  publishedAt     DateTime
  summary         String
  tlDr            String?
  content         String?
  tags            String[]
  category        Category
  imageUrl        String?
  relatedArticles String[]
  byline          String?    // reporter id from src/broadcast/lineup.json
  sources         Json?      // every outlet the story draws on: [{name, url, author, publishedAt, lean}]
  judge           Json?      // WaterSheep scores: relevance, support, clickbait

  // Agent pipeline tracking
  storyStatus     StoryStatus @default(raw)
  agentsInvolved  String[]   @default([])
  sourcesAnalyzed Int        @default(0)
  factCheckStatus String     @default("pending")

  // Confidence scores
  overallConfidence  Float?  @map("overall_confidence")
  sourceQuality      Float?  @map("source_quality")
  controversyScore   Float?  @map("controversy_score")
  citationCount      Int?    @map("citation_count")
  verifiedClaims     Int?    @map("verified_claims")
  unverifiedClaims   Int?    @map("unverified_claims")
  hallucinationRisk  Float?  @map("hallucination_risk")

  // Risk assessment
  riskLevel          String? @default("low") @map("risk_level")
  riskFactors        String[] @default([]) @map("risk_factors")
  requiresHumanReview Boolean @default(false) @map("requires_human_review")
  legalConcerns      String[] @default([]) @map("legal_concerns")
  biasConcerns       String[] @default([]) @map("bias_concerns")
  safetyFlags        String[] @default([]) @map("safety_flags")

  // Human review
  humanReviewer String? @map("human_reviewer")
  humanNotes    String? @map("human_notes")

  // Timestamps
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  publishedAtReal DateTime?  @map("published_at_real")

  // Relations
  scores          Scores?
  agentActions    AgentAction[]
}

model Scores {
  id              String @id @default(cuid())
  articleId       String @unique
  article         Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  signalScore     Int    @default(0)
  hypeScore       Int    @default(0)
  builderScore    Int    @default(0)
  securityScore   Int    @default(0)
  openSourceScore Int    @default(0)
  enterpriseScore Int    @default(0)
  overallScore    Int    @default(0)
}

model AgentAction {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  agentRole   String
  state       String   @default("pending")
  startedAt   DateTime?
  completedAt DateTime?
  output      Json?
  error       String?
  durationMs  Int?

  createdAt DateTime @default(now())
}

model Source {
  id          String   @id @default(cuid())
  name        String   @unique
  url         String?
  type        String   // rss | hackernews | arxiv | github_trending | huggingface
  category    String?  // the beat its items usually belong to
  aiOnly      Boolean  @default(false) // every item is AI news: skip relevance screening
  lean        String?  // political lean from Ad Fontes Media: left .. right
  paywalled   Boolean  @default(false)
  isActive    Boolean  @default(true)
  lastFetched DateTime? // last attempt
  lastSuccessAt DateTime?
  lastError   String?
  lastItemCount Int?
  failures    Int      @default(0) // failed fetches in a row
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id           String   @id @default(cuid())
  name         String   @unique
  articleCount Int      @default(0)
  createdAt    DateTime @default(now())
}

// ─── Live broadcast ───
// Written by ann-agents/src/ann_agents/broadcast, read by /api/live and the
// streamer. One row per segment on the single shared timeline.
model BroadcastSegment {
  id         String   @id
  showId     String
  kind       String   // story | reel | ident
  startsAt   DateTime
  endsAt     DateTime
  durationMs Int
  title      String
  anchors    String[]
  articleIds String[]
  // { articles: SegmentArticle[], lines: ScriptLine[], dropped: DroppedLine[] }
  script     Json
  writer     String   // model id that wrote it, or "reel"
  costUsd    Float    @default(0)
  createdAt  DateTime @default(now())

  @@index([startsAt])
  @@index([endsAt])
}

// Claude spend per UTC day, checked against BROADCAST_DAILY_BUDGET_USD.
model BroadcastSpend {
  day          String   @id // YYYY-MM-DD, UTC
  usd          Float    @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  calls        Int      @default(0)
  updatedAt    DateTime @default(now())
}

// Who is watching. Browsers on /live and the YouTube streamer check in;
// the broadcast writes nothing when no one has checked in recently.
model LiveViewer {
  id         String   @id
  kind       String   @default("web") // web | streamer
  lastSeenAt DateTime @default(now())

  @@index([lastSeenAt])
}

// Viewer accounts, for sending the desk questions.
model User {
  id           String   @id @default(cuid())
  handle       String   @unique // shown on air with a question, e.g. @pixelfan
  passwordHash String
  createdAt    DateTime @default(now())
  questions    ViewerQuestion[]
}

enum QuestionStatus {
  received    // waiting for the desk
  screened    // WaterSheep: not a question about the news, or not something we read on air
  declined    // the desk decided not to take it on (reason given)
  answered    // researched and answered from ANN's reporting
  aired       // answered on ANN Live too
}

model ViewerQuestion {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  status     QuestionStatus @default(received)
  reason     String?        // why it was screened out or declined, shown to the viewer
  answer     String?
  articleIds String[]       @default([]) // the ANN stories the answer is drawn from
  judge      Json?          // WaterSheep's scores for the screen and the answer
  segmentId  String?        // the broadcast segment it aired in
  createdAt  DateTime       @default(now())
  answeredAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
