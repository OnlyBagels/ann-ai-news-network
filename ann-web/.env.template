# ─── Database ───
# format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=<schema>
DATABASE_URL=""

# ─── Redis (Upstash) ───
REDIS_URL=""
REDIS_TOKEN=""

# ─── Meilisearch ───
MEILISEARCH_HOST="http://localhost:7700"
# set a master key when running Meilisearch in production
MEILISEARCH_API_KEY=""

# ─── Newsletter (Listmonk) ───
LISTMONK_URL=""
LISTMONK_TOKEN=""

# ─── Agent Service ───
AGENT_SERVICE_URL="http://localhost:8001"
# Must match AGENT_API_TOKEN in ann-agents/.env when that is set
AGENT_API_TOKEN=""

# ─── Admin ───
# Editors sign in at /admin/login with this token; with it empty the admin
# pages and APIs stay locked. Generate one: openssl rand -base64 32
ADMIN_TOKEN=""
# The session cookie is Secure in production. Only for testing over plain
# http on a non-localhost address, set this to true.
ADMIN_COOKIE_INSECURE=""

# ─── LLM API Keys ───
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
GROK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ─── External API Keys ───
GITHUB_TOKEN=""
HUGGINGFACE_TOKEN=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# ─── Live broadcast ───
# Where ann-agents writes voiced lines (same folder as its BROADCAST_AUDIO_DIR)
BROADCAST_AUDIO_DIR="../broadcast-audio"
# The YouTube stream embedded on the front page and /live. Set the channel
# id (UC...) to embed whatever it is streaming, or one live video id.
# Unset, the site draws the channel itself.
YOUTUBE_CHANNEL_ID=""
YOUTUBE_VIDEO_ID=""
# How far YouTube runs behind real time; the transcript waits this long
YOUTUBE_DELAY_SECONDS="20"
# Used by scripts/stream.ts
YOUTUBE_STREAM_KEY=""
ANN_SITE_URL="http://localhost:3000"
